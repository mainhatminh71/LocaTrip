# Prefer public Keycloak unless you run Keycloak locally on :8080
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.locatrip.app
NEXT_PUBLIC_KEYCLOAK_REALM=localtrip
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=localtrip-app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Search Console verification token (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Nginx API gateway (docker compose) — not :5000 monolith / not :5003 payment service.
NEXT_PUBLIC_API_BASE_URL=http://localhost
LOCALTRIP_USE_PUBLIC_API=false
LOCALTRIP_API_URL=http://localhost
# LOCALTRIP_PUBLIC_API_URL=https://localtrip-production.up.railway.app

# Mapbox (existing)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/outdoors-v12
