NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=localtrip
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=localtrip-app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Search Console verification token (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# false → local LocalTrip (:5000). true → Railway public API.
LOCALTRIP_USE_PUBLIC_API=false
LOCALTRIP_API_URL=http://localhost:5000
# LOCALTRIP_PUBLIC_API_URL=https://localtrip-production.up.railway.app

# Mapbox (existing)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/outdoors-v12
