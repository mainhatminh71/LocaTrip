{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "locatrip-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    // Trip/auth via DO gateway; payment/wallet still Railway (same as prod)
    "LOCALTRIP_USE_PUBLIC_API": "true",
    "LOCALTRIP_PUBLIC_API_URL": "https://api.locatrip.app",
    "LOCALTRIP_PAYMENT_SERVICE_URL": "https://localtrip-paymentservice-production.up.railway.app"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "locatrip-staging"
    }
  ]
}
