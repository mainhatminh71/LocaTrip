{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "locatrip-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "locatrip"
    }
  ],
  "vars": {
    // Trip/auth/payment via DO gateway (same as prod)
    "LOCALTRIP_USE_PUBLIC_API": "true",
    "LOCALTRIP_PUBLIC_API_URL": "https://api.locatrip.app",
    "LOCALTRIP_PAYMENT_SERVICE_URL": "https://api.locatrip.app",
    "R2_PUBLIC_URL": "https://pub-b88157c7e2b9415da4d0bb9a4fac1496.r2.dev",
    "R2_BUCKET": "locatrip"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "locatrip-staging"
    }
  ]
}
