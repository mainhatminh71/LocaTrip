# Public app origin (optional; defaults to window.location.origin)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_KEYCLOAK_URL=https://auth.locatrip.app
NEXT_PUBLIC_KEYCLOAK_REALM=localtrip
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=localtrip-app

# --- LocalTrip backend upstream (Next.js API proxies) ---
# Toggle public Railway API (https://localtrip-production.up.railway.app).
# When true, LOCALTRIP_API_URL is ignored.
LOCALTRIP_USE_PUBLIC_API=false

# Optional override of the public base (only used when toggle is true)
# LOCALTRIP_PUBLIC_API_URL=https://localtrip-production.up.railway.app

# Local / custom API when toggle is false
LOCALTRIP_API_URL=http://localhost:5000
