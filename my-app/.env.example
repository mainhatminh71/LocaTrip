# Public app origin — used for canonical URLs, sitemap, Open Graph, OIDC redirects.
# Production: https://locatrip.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Search Console HTML-tag verification token (meta name="google-site-verification").
# Get it from https://search.google.com/search-console → Add property → HTML tag.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

NEXT_PUBLIC_KEYCLOAK_URL=https://auth.locatrip.app
NEXT_PUBLIC_KEYCLOAK_REALM=localtrip
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=localtrip-app

# --- LocalTrip API (Next.js proxies → gateway) ---
# Local docker compose gateway is http://localhost (port 80).
# Do NOT use http://localhost:5000 (old monolith) or :5003 (payment service internal).
NEXT_PUBLIC_API_BASE_URL=http://localhost
LOCALTRIP_API_URL=http://localhost

# Local: keep false so proxies use LOCALTRIP_API_URL above.
# Prod/staging Workers (wrangler vars): USE_PUBLIC_API=true + PUBLIC_API_URL=DO gateway.
LOCALTRIP_USE_PUBLIC_API=false

# Production DigitalOcean API gateway (Caddy → Nginx → trip/auth).
# When set (and ≠ legacy dead Railway host), all proxy kinds use this single URL.
# LOCALTRIP_PUBLIC_API_URL=https://api.locatrip.app

# Legacy per-service Railway fallbacks (only when USE_PUBLIC_API=true and PUBLIC_API_URL unset).
# LOCALTRIP_TRIP_SERVICE_URL=https://localtrip-tripservice-production.up.railway.app
# LOCALTRIP_PAYMENT_SERVICE_URL=https://localtrip-paymentservice-production.up.railway.app
