POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=locatrip
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345

DATABASE_URL=postgresql+psycopg://postgres:12345@localhost:5432/locatrip

OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter,https://z.overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=120
HTTP_MAX_RETRIES=4

# Đà Lạt urban area (south, west, north, east)
CRAWL_REGION=dalat
BBOX_SOUTH=11.88
BBOX_WEST=108.38
BBOX_NORTH=12.00
BBOX_EAST=108.52
CRAWL_GRID_SIZE=2

# Set > 0 to enable APScheduler periodic crawls
CRAWL_INTERVAL_MINUTES=0

APP_NAME=road-scraper
APP_ENV=development
LOG_LEVEL=INFO

# Mapbox public token (pk.*) for the scenic demo basemap
MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE=mapbox/outdoors-v12
